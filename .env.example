# DEMO ONLY. Copy to .env and fill in.
# Password for both SIP accounts ("caller" and "staff"); letters and digits only, e.g. from: openssl rand -hex 16
PUENTE_SIP_PASSWORD=
# The address softphones reach: the VM's public IP, or the machine's LAN IP for a local test
PUENTE_PUBLIC_IP=
# Optional safety classifier directory under ./models (e.g. /models/safety); empty means rules only
PUENTE_SAFETY_MODEL=
