; DEMO ONLY. Two accounts: "caller" (a softphone that calls the agent) and "staff" (a softphone that receives
; transfers). There is no trunk, so nothing here can dial an outside number. @SIP_PASSWORD@ and @PUBLIC_IP@ are filled
; from .env when the container starts.

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
external_media_address=@PUBLIC_IP@
external_signaling_address=@PUBLIC_IP@
local_net=10.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16

[phone](!)
type=endpoint
disallow=all
allow=ulaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[caller](phone)
context=puente-in
auth=caller
aors=caller

[staff](phone)
context=staff-in
auth=staff
aors=staff

[caller]
type=auth
auth_type=userpass
username=caller
password=@SIP_PASSWORD@

[staff]
type=auth
auth_type=userpass
username=staff
password=@SIP_PASSWORD@

[caller]
type=aor
max_contacts=1

[staff]
type=aor
max_contacts=1
